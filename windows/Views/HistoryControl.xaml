<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="HeartRate.Views.HistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:HeartRate.Views"
             xmlns:vm="using:HeartRate.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="600">

    <Grid RowSpacing="12"
          Padding="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 标题 + 实时北京时间 ────────────────────────────────────────── -->
        <Grid Grid.Row="0">
            <TextBlock x:Uid="History_Title"
                       Text="历史记录"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE121;"
                          FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Uid="History_NowLabel"
                           Text="北京时间"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.NowText, Mode=OneWay}"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- ── 今日统计（北京时间当天） ───────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.TodayTitle, Mode=OneWay}"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Uid="History_Avg" Text="平均" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TodayAvgText, Mode=OneWay}"
                                   FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="History_Max" Text="最高" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TodayMaxText, Mode=OneWay}"
                                   FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock x:Uid="History_Min" Text="最低" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TodayMinText, Mode=OneWay}"
                                   FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2">
                        <TextBlock x:Uid="History_Duration" Text="时长" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TodayDurationText, Mode=OneWay}"
                                   FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="2">
                        <TextBlock x:Uid="History_Records" Text="记录" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TodayCountText, Mode=OneWay}"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── 会话列表 + 详情 ─────────────────────────────────────────────── -->
        <Grid Grid.Row="2"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MinWidth="260" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- 左：会话列表 -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0"
                              ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryItem">
                                <StackPanel Spacing="2"
                                            Padding="0,6">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                   FontWeight="SemiBold" />
                                        <Border Visibility="{x:Bind InProgress, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,0">
                                            <TextBlock x:Uid="History_Live"
                                                       Text="进行中"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind TimeText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind StatsText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="0"
                               x:Uid="History_Empty"
                               Text="暂无历史记录。连接心率设备后会自动记录。"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.55"
                               Margin="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Uid="History_DeleteSelected"
                                Content="删除所选"
                                Command="{x:Bind ViewModel.DeleteSelectedCommand}" />
                        <Button x:Uid="History_ClearAll"
                                Content="清空">
                            <Button.Flyout>
                                <Flyout x:Name="ClearFlyout">
                                    <StackPanel Spacing="12"
                                                MaxWidth="260">
                                        <TextBlock x:Uid="History_ClearHint"
                                                   Text="将删除全部已结束的历史记录，无法恢复。"
                                                   TextWrapping="Wrap" />
                                        <Button x:Uid="History_ClearConfirm"
                                                Content="确认清空"
                                                Command="{x:Bind ViewModel.ClearAllCommand}"
                                                Click="OnClearConfirmClick" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：选中会话详情 -->
            <Border Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid>
                    <TextBlock x:Uid="History_SelectHint"
                               Text="选择左侧一条记录查看详情"
                               Opacity="0.55"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.HasDetail, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                    <ScrollView Visibility="{x:Bind ViewModel.HasDetail, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Padding="20"
                                    Spacing="20">
                            <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <!-- 均值统计 -->
                            <Grid ColumnSpacing="16"
                                  RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock x:Uid="History_Avg" Text="平均" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailAvgText, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="History_Max" Text="最高" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailMaxText, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                                    <TextBlock x:Uid="History_Min" Text="最低" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailMinText, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                    <TextBlock x:Uid="History_Duration" Text="时长" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailDurationText, Mode=OneWay}"
                                               FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="History_SampleCount" Text="采样数" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailCountText, Mode=OneWay}"
                                               FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                                    <TextBlock x:Uid="History_Range" Text="时间段（北京时间）" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailRangeText, Mode=OneWay}"
                                               FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <!-- 曲线（横轴为北京时间） -->
                            <local:HeartRateChartControl x:Name="DetailChart" />
                        </StackPanel>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
